+/// A whole [`EARLY`] piece, committed, for a request of its size.
+fn from_early(len: usize) -> Option<usize> {
+    use windows_sys::Win32::System::Memory::{MEM_COMMIT, PAGE_READWRITE, VirtualAlloc};
+    if len != EARLY_PIECE {
+        return None;
+    }
