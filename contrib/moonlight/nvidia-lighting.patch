+        for _ in 0..(mb << 20) / EARLY_PIECE {
+            let Ok(at) = allocate_in_window(EARLY_PIECE, MEM_RESERVE | MEM_WRITE_WATCH) else {
+                break;
+            };
+            early.push(at);
